<IfModule mod_rewrite.c>
  RewriteEngine On
  
  # Permitir métodos POST, PUT, DELETE, PATCH sin reescritura
  RewriteCond %{REQUEST_METHOD} ^(POST|PUT|DELETE|PATCH)$ [NC]
  RewriteRule ^ - [L]

  # Redirect to HTTPS if needed (optional, depends on host)
  # RewriteCond %{HTTPS} off
  # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Si es archivo o directorio real, no reescribir
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} -f [OR]
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} -d
  RewriteRule ^ - [L]

  # Fallback: todo lo demás a index.html (Angular routing)
  RewriteRule ^ index.html [L]
</IfModule>

# --- EVITAR CACHÉ EN INDEX.HTML ---
# Esto obliga al navegador a descargar el nuevo index.html en cada visita.
# Como Angular renombra los JS y CSS en cada build (hash), esto soluciona el problema de caché.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
